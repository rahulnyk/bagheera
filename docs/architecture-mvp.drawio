  <diagram id="MVP" name="MVP">
    <mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="970" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;Bagheera MVP: what one team runs&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;fontSize=18;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1440" height="32" as="geometry" /></mxCell>
        <mxCell id="subtitle" value="Everything runs on laptops, with nothing from org admins. The only workflow is the library's format check. The target state is in architecture-target.drawio." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;fontSize=13;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1440" height="24" as="geometry" /></mxCell>
        <mxCell id="p_pm" value="&lt;b&gt;PM · tech lead&lt;/b&gt;&lt;br&gt;named in the spec, asked to approve" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=13;fontColor=#333333;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="130" y="110" width="240" height="70" as="geometry" /></mxCell>
        <mxCell id="p_dev" value="&lt;b&gt;Developer&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=13;fontColor=#333333;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="650" y="110" width="220" height="70" as="geometry" /></mxCell>
        <mxCell id="p_lib" value="&lt;b&gt;Library approvers, by process&lt;/b&gt;&lt;br&gt;the ticket's tech lead or PM;&lt;br&gt;the architecture council for standards" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=13;fontColor=#333333;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="1100" y="110" width="340" height="70" as="geometry" /></mxCell>
        <mxCell id="lane_repo" value="Product repos · GitHub" style="swimlane;shape=swimlane;startSize=30;rounded=1;arcSize=4;whiteSpace=wrap;html=1;strokeWidth=2;fontStyle=1;fontSize=14;fontColor=#333333;fillColor=#D5E8D4;strokeColor=#82B366;swimlaneFillColor=#FFFFFF;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="240" width="420" height="450" as="geometry" /></mxCell>
        <mxCell id="lane_laptop" value="Laptop · Claude Code" style="swimlane;shape=swimlane;startSize=30;rounded=1;arcSize=4;whiteSpace=wrap;html=1;strokeWidth=2;fontStyle=1;fontSize=14;fontColor=#333333;fillColor=#DAE8FC;strokeColor=#6C8EBF;swimlaneFillColor=#FFFFFF;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="540" y="240" width="440" height="450" as="geometry" /></mxCell>
        <mxCell id="lane_lib" value="Council Rock · the org's knowledge library" style="swimlane;shape=swimlane;startSize=30;rounded=1;arcSize=4;whiteSpace=wrap;html=1;strokeWidth=2;fontStyle=1;fontSize=14;fontColor=#333333;fillColor=#FFF2CC;strokeColor=#D6B656;swimlaneFillColor=#FFFFFF;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="1060" y="240" width="420" height="450" as="geometry" /></mxCell>
        <mxCell id="r_pr" value="&lt;b&gt;The ticket's PR&lt;/b&gt;&lt;br&gt;one branch per ticket, such as PAY-412&lt;br&gt;spec · plan · tests and code, phase by phase&lt;br&gt;/approved comments, listed with who and when" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=13;fontColor=#333333;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="lane_repo"><mxGeometry x="30" y="50" width="360" height="120" as="geometry" /></mxCell>
        <mxCell id="r_ci" value="&lt;b&gt;Repo CI&lt;/b&gt;&lt;br&gt;tests, as today" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=13;fontColor=#333333;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="lane_repo"><mxGeometry x="30" y="190" width="360" height="60" as="geometry" /></mxCell>
        <mxCell id="r_rule" value="&lt;b&gt;Branch rule&lt;/b&gt;&lt;br&gt;changes by PR · no force-push on main" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=13;fontColor=#333333;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="lane_repo"><mxGeometry x="30" y="270" width="360" height="60" as="geometry" /></mxCell>
