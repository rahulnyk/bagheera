        <mxCell id="b_pages" value="&lt;b&gt;Pages, by type then domain&lt;/b&gt;&lt;br&gt;standards/org/ · services/payments/ · …&lt;br&gt;six header fields · shelf life · approved_by" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=13;fontColor=#333333;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="lane_lib"><mxGeometry x="30" y="50" width="360" height="110" as="geometry" /></mxCell>
