      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;Bagheera: the MVP's components and how they connect&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1440" height="32" as="geometry" /></mxCell>
        <mxCell id="subtitle" value="What one team runs, with nothing from org admins. Parts that need org-wide coordination are in docs/proposals/org-adoption.md." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1440" height="24" as="geometry" /></mxCell>
        <mxCell id="p_pm" value="&lt;b&gt;PM · tech lead&lt;/b&gt;&lt;br&gt;named in the spec, asked to approve" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=13;fontColor=#333333;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="140" y="110" width="240" height="70" as="geometry" /></mxCell>
